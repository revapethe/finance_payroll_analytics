{
  "name": "PayrollAnalytics",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"C:\\PayrollAnalytics\\data\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "dim_department",
        "columns": [
          {
            "name": "department_key",
            "dataType": "int64",
            "sourceColumn": "department_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "department",
            "dataType": "string",
            "sourceColumn": "department",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_department",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/dim_department.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"department_key\", Int64.Type}, {\"department\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_location",
        "columns": [
          {
            "name": "location_key",
            "dataType": "int64",
            "sourceColumn": "location_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "city",
            "dataType": "string",
            "sourceColumn": "city",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_location",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/dim_location.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"location_key\", Int64.Type}, {\"country\", type text}, {\"city\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_employee",
        "columns": [
          {
            "name": "employee_id",
            "dataType": "string",
            "sourceColumn": "employee_id",
            "summarizeBy": "none"
          },
          {
            "name": "job_title",
            "dataType": "string",
            "sourceColumn": "job_title",
            "summarizeBy": "none"
          },
          {
            "name": "remote_status",
            "dataType": "string",
            "sourceColumn": "remote_status",
            "summarizeBy": "none"
          },
          {
            "name": "performance",
            "dataType": "string",
            "sourceColumn": "performance",
            "summarizeBy": "none"
          },
          {
            "name": "hire_date",
            "dataType": "dateTime",
            "sourceColumn": "hire_date",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_employee",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/dim_employee.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"employee_id\", type text}, {\"job_title\", type text}, {\"remote_status\", type text}, {\"performance\", type text}, {\"hire_date\", type date}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_snapshot",
        "columns": [
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "summarizeBy": "none"
          },
          {
            "name": "calendar_year",
            "dataType": "int64",
            "sourceColumn": "calendar_year",
            "summarizeBy": "none"
          },
          {
            "name": "calendar_month",
            "dataType": "int64",
            "sourceColumn": "calendar_month",
            "summarizeBy": "none"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_snapshot",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/dim_snapshot.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"snapshot_date\", type date}, {\"calendar_year\", Int64.Type}, {\"calendar_month\", Int64.Type}, {\"month_name\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "fact_compensation",
        "columns": [
          {
            "name": "snapshot_date",
            "dataType": "dateTime",
            "sourceColumn": "snapshot_date",
            "summarizeBy": "none"
          },
          {
            "name": "employee_id",
            "dataType": "string",
            "sourceColumn": "employee_id",
            "summarizeBy": "none"
          },
          {
            "name": "department_key",
            "dataType": "int64",
            "sourceColumn": "department_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "location_key",
            "dataType": "int64",
            "sourceColumn": "location_key",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "currency",
            "dataType": "string",
            "sourceColumn": "currency",
            "summarizeBy": "none"
          },
          {
            "name": "annual_salary_local",
            "dataType": "decimal",
            "sourceColumn": "annual_salary_local",
            "summarizeBy": "none"
          },
          {
            "name": "annual_salary_usd",
            "dataType": "decimal",
            "sourceColumn": "annual_salary_usd",
            "summarizeBy": "none"
          },
          {
            "name": "years_of_service",
            "dataType": "double",
            "sourceColumn": "years_of_service",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_compensation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/fact_compensation.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"snapshot_date\", type date}, {\"employee_id\", type text}, {\"department_key\", Int64.Type}, {\"location_key\", Int64.Type}, {\"currency\", type text}, {\"annual_salary_local\", Currency.Type}, {\"annual_salary_usd\", Currency.Type}, {\"years_of_service\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Headcount",
            "expression": "COUNTROWS('fact_compensation')",
            "formatString": "#,0",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Annual Salary Run Rate USD",
            "expression": "SUM('fact_compensation'[annual_salary_usd])",
            "formatString": "$#,0.00",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Monthly Salary Equivalent USD",
            "expression": "DIVIDE([Annual Salary Run Rate USD], 12)",
            "formatString": "$#,0.00",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Average Salary USD",
            "expression": "AVERAGE('fact_compensation'[annual_salary_usd])",
            "formatString": "$#,0.00",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Median Salary USD",
            "expression": "MEDIAN('fact_compensation'[annual_salary_usd])",
            "formatString": "$#,0.00",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "P90 Salary USD",
            "expression": "PERCENTILEX.INC('fact_compensation', 'fact_compensation'[annual_salary_usd], 0.9)",
            "formatString": "$#,0.00",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Remote Headcount",
            "expression": "CALCULATE([Headcount], KEEPFILTERS('dim_employee'[remote_status] = \"Remote\"))",
            "formatString": "#,0",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Remote Share",
            "expression": "DIVIDE([Remote Headcount], [Headcount])",
            "formatString": "0.0%",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Average Tenure Years",
            "expression": "AVERAGE('fact_compensation'[years_of_service])",
            "formatString": "#,0.0",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Department Salary Share",
            "expression": "DIVIDE([Annual Salary Run Rate USD], CALCULATE([Annual Salary Run Rate USD], REMOVEFILTERS('dim_department')))",
            "formatString": "0.0%",
            "displayFolder": "Payroll KPIs"
          },
          {
            "name": "Snapshot Date",
            "expression": "MAX('fact_compensation'[snapshot_date])",
            "formatString": "yyyy-mm-dd",
            "displayFolder": "Payroll KPIs"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "fact_to_dim_department",
        "fromTable": "fact_compensation",
        "fromColumn": "department_key",
        "toTable": "dim_department",
        "toColumn": "department_key",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_location",
        "fromTable": "fact_compensation",
        "fromColumn": "location_key",
        "toTable": "dim_location",
        "toColumn": "location_key",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_employee",
        "fromTable": "fact_compensation",
        "fromColumn": "employee_id",
        "toTable": "dim_employee",
        "toColumn": "employee_id",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      },
      {
        "name": "fact_to_dim_snapshot",
        "fromTable": "fact_compensation",
        "fromColumn": "snapshot_date",
        "toTable": "dim_snapshot",
        "toColumn": "snapshot_date",
        "crossFilteringBehavior": "oneDirection",
        "fromCardinality": "many",
        "toCardinality": "one",
        "isActive": true
      }
    ]
  }
}
