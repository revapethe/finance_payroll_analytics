{
  "name": "Payroll Analytics",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
  "postAttachCommand": ".venv/bin/python -m streamlit run app/dashboard.py --server.headless true --browser.gatherUsageStats false",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "Payroll Analytics"}}
}
